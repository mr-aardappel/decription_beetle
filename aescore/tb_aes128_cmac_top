`timescale 1ns / 1ps

module tb_aes128_cmac_top;

    reg          clk;
    reg          rst;
    reg          init_key;
    reg          start_msg;
    reg          process_block;
    reg          is_final_block;
    reg          is_complete;
    reg  [127:0] key;
    reg  [127:0] data_in;
    reg  [127:0] received_mac;
    wire [127:0] mac_out;
    wire         mac_valid;
    wire         mac_done;
    wire         ready;

    aes128_cmac_top uut (
        .clk            (clk),
        .rst            (rst),
        .init_key       (init_key),
        .start_msg      (start_msg),
        .process_block  (process_block),
        .is_final_block (is_final_block),
        .is_complete    (is_complete),
        .key            (key),
        .data_in        (data_in),
        .received_mac   (received_mac),
        .mac_out        (mac_out),
        .mac_valid      (mac_valid),
        .mac_done       (mac_done),
        .ready          (ready)
    );

    always #5 clk = ~clk;

    initial begin
        $dumpfile("tb_aes128_cmac_top.vcd");
        $dumpvars(0, tb_aes128_cmac_top);
    end

    // NIST SP 800-38B D.1 Constants
    localparam [127:0] NIST_KEY    = 128'h2b7e151628aed2a6abf7158809cf4f3c;
    localparam [127:0] M_EMPTY_PAD = 128'h80000000000000000000000000000000;
    localparam [127:0] M_BLK_0     = 128'h6bc1bee22e409f96e93d7e117393172a;
    localparam [127:0] M_BLK_1     = 128'hae2d8a571e03ac9c9eb76fac45af8e51;
    localparam [127:0] M_BLK_2_PAD = 128'h30c81c46a35ce4118000000000000000;

    localparam [127:0] TAG_EX1_0B  = 128'hbb1d6929e95937287fa37d129b756746;
    localparam [127:0] TAG_EX2_16B = 128'h070a16b46b4d4144f79bdd9dd04a287c;
    localparam [127:0] TAG_EX3_40B = 128'hdfa66747de9ae63030ca32611497c827;

    // All-Zeros Vector
    localparam [127:0] ZERO_KEY    = 128'h00000000000000000000000000000000;
    localparam [127:0] ZERO_TAG    = 128'h099b18a6c0f73e9e91928981b3545340;

    integer errors;

    task load_key;
        input [127:0] t_key;
        begin
            @(negedge clk);
            key      = t_key;
            init_key = 1'b1;
            @(negedge clk);
            init_key = 1'b0;

            // Wait for subkeys to finish deriving and top-level ready to assert
            wait (ready == 1'b1);
        end
    endtask

    task start_new_msg;
        input [127:0] exp_mac;
        begin
            wait (ready == 1'b1);
            @(negedge clk);
            received_mac = exp_mac;
            start_msg    = 1'b1;
            @(negedge clk);
            start_msg    = 1'b0;
        end
    endtask

    task send_block;
        input [127:0] t_data;
        input         t_final;
        input         t_complete;
        begin
            wait (ready == 1'b1);
            @(negedge clk);
            data_in        = t_data;
            is_final_block = t_final;
            is_complete    = t_complete;
            process_block  = 1'b1;
            @(negedge clk);
            process_block  = 1'b0;

            if (t_final) begin
                @(posedge mac_done);
                #1;
            end else begin
                @(negedge ready);
                @(posedge ready);
            end
        end
    endtask

    task verify_result;
        input [127:0] exp_mac;
        input         exp_valid;
        input [127:0] label;
        begin
            if (mac_out !== exp_mac || mac_valid !== exp_valid) begin
                $display("[FAIL] %0s | MAC: %h (Exp: %h) | valid: %b (Exp: %b)",
                         label, mac_out, exp_mac, mac_valid, exp_valid);
                errors = errors + 1;
            end else begin
                $display("[PASS] %0s | MAC: %h | mac_valid: %b",
                         label, mac_out, mac_valid);
            end
        end
    endtask

    initial begin
        clk            = 0;
        rst            = 1;
        init_key       = 0;
        start_msg      = 0;
        process_block  = 0;
        is_final_block = 0;
        is_complete    = 0;
        key            = 128'h0;
        data_in        = 128'h0;
        received_mac   = 128'h0;
        errors         = 0;

        #20 rst = 0;
        #10;

        $display("==========================================================");
        $display(" Testing aes128_cmac_top - NIST SP 800-38B");
        $display("==========================================================");

        load_key(NIST_KEY);

        // 1. NIST Example 1 (0 bytes, valid tag check)
        start_new_msg(TAG_EX1_0B);
        send_block(M_EMPTY_PAD, 1'b1, 1'b0);
        verify_result(TAG_EX1_0B, 1'b1, "NIST EX1 VALID");

        // 2. NIST Example 2 (16 bytes, valid tag check)
        start_new_msg(TAG_EX2_16B);
        send_block(M_BLK_0, 1'b1, 1'b1);
        verify_result(TAG_EX2_16B, 1'b1, "NIST EX2 VALID");

        // 3. NIST Example 3 (40 bytes, valid tag check)
        start_new_msg(TAG_EX3_40B);
        send_block(M_BLK_0,     1'b0, 1'b0);
        send_block(M_BLK_1,     1'b0, 1'b0);
        send_block(M_BLK_2_PAD, 1'b1, 1'b0);
        verify_result(TAG_EX3_40B, 1'b1, "NIST EX3 VALID");

        // 4. NIST Example 3 with corrupted received_mac (tamper check)
        start_new_msg(TAG_EX3_40B ^ 128'h1);
        send_block(M_BLK_0,     1'b0, 1'b0);
        send_block(M_BLK_1,     1'b0, 1'b0);
        send_block(M_BLK_2_PAD, 1'b1, 1'b0);
        verify_result(TAG_EX3_40B, 1'b0, "NIST EX3 TAMPER");

        $display("==========================================================");
        $display(" Testing aes128_cmac_top - All-Zeros Vector");
        $display("==========================================================");

        load_key(ZERO_KEY);

        // 5. All-Zeros Key + 16-byte All-Zeros Message
        start_new_msg(ZERO_TAG);
        send_block(128'h0, 1'b1, 1'b1);
        verify_result(ZERO_TAG, 1'b1, "ALL ZEROS VALID");

        $display("==========================================================");
        if (errors == 0) $display(" ALL TOP-LEVEL CMAC TESTS PASSED!");
        else             $display(" COMPLETED WITH %0d ERROR(S).", errors);
        $display("==========================================================");
        $finish;
    end

endmodule